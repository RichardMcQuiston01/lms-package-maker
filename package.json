{
  "name": "lms-package-maker",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Richard McQuiston",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/model packages/exporters && bun run --cwd apps/web typecheck",
    "test": "bun test packages/model/src packages/exporters/src apps/web/lib",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1",
    "prettier": "^3",
    "typescript": "~5.8.3"
  }
}
