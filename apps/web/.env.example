# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_package_maker"
# Directory for stored files (uploaded media, exported packages) and the error log.
LMS_DATA_DIR="./data"
# Signs the short-lived preview links. Required in production: at least 32 random
# characters, for example the output of: openssl rand -base64 48
AUTH_SECRET=""
# Accounts: the first person to sign up becomes the owner of any existing courses.
# After that, sign-up stays closed unless this is "true".
ALLOW_SIGN_UP="false"

# Who is signed in: builtin (default), header, or single-user. See the README, "Identity".
IDENTITY_PROVIDER="builtin"
# header mode (a login proxy in front of the app sets these headers):
# IDENTITY_PROXY_SECRET=""         # required, 16+ characters; the proxy must send it in IDENTITY_SECRET_HEADER
# IDENTITY_SECRET_HEADER="x-identity-proxy-secret"
# IDENTITY_USER_HEADER="x-forwarded-user"
# IDENTITY_NAME_HEADER="x-forwarded-preferred-username"
# IDENTITY_EMAIL_HEADER="x-forwarded-email"
# IDENTITY_SIGN_IN_URL=""          # where signed-out visitors are sent
# IDENTITY_SIGN_OUT_URL=""         # where "Sign out" leads
# single-user mode (no sign-in; one trusted person only):
# SINGLE_USER_NAME="Local user"
# IDENTITY_SINGLE_USER_ACKNOWLEDGED="true"   # required in production
