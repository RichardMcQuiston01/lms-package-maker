generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A course being authored. The Course Model JSON is the single source for exports.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   @default("")
  courseJson  Json     @map("course_json")
  /// Null only for projects made before sign-in existed; the first account claims them.
  ownerId     String?  @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User?           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  exports PackageExport[]
  media   Media[]

  @@index([ownerId])
  @@map("project")
}

/// One generated package. The zip itself lives in storage under `storageKey`.
model PackageExport {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  standard   String
  storageKey String   @map("storage_key")
  byteSize   Int      @map("byte_size")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("package_export")
}

/// A person who can sign in. Email is stored lower-case.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  /// scrypt hash in the form scrypt$N$r$p$salt$hash; never the password.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  projects Project[]

  @@map("user")
}

/// A signed-in browser. Only the SHA-256 of the cookie token is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// An uploaded image, audio or video file. The bytes live in storage under `storageKey`.
model Media {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  /// What the author uploaded, cleaned for display only; never used as a path.
  fileName    String   @map("file_name")
  /// Decided from the file's first bytes, not from what the browser claimed.
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  sha256      String
  storageKey  String   @unique @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("media")
}
